{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "make BUILD=Debug",
      "presentation": {
        "echo": true,
        "reveal": "never",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build Release",
      "type": "shell",
      "command": "make",
      "presentation": {
      "echo": true,
      "reveal": "never",
      "focus": false,
      "panel": "shared",
      "showReuseMessage": true,
      "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make clean",
      "group": {
        "kind": "build"
      }
    },
      {
      "label": "Nops Up",
      "type": "shell",
      "command": "mono ~/PSX/NOTPSXSerial/nops.exe /reset && mono ~/PSX/NOTPSXSerial/nops.exe /slow /gdb 127.0.0.1:3333 /dev/ttyUSB0",
      "dependsOn":["Build Debug"],
    },
  ]
}