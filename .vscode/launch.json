{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "gdb",
      "request": "attach",
      "target": "localhost:3333",
      "remote": true,
      "cwd": "${workspaceRoot}",
      "valuesFormatting": "parseText",
      "stopAtConnect": true,
      "gdbpath": "/usr/bin/gdb",
      "windows": {
        "gdbpath": "gdb-multiarch.exe"
      },
      "osx": {
        "gdbpath": "gdb"
      },
      "executable": "${workspaceRoot}/psxeg.elf",
      "preLaunchTask": "Build Release",
      "autorun": [
        "monitor reset hard shellhalt",
        "load psxeg.elf",
        "tbreak main",
        "continue"
      ]
    },
    {
      "name": "ISODebug",
      "type": "gdb",
      "request": "attach",
      "target": "localhost:3333",
      "remote": true,
      "cwd": "${workspaceRoot}",
      "valuesFormatting": "parseText",
      "stopAtConnect": true,
      "gdbpath": "gdb",
      "windows": {
        "gdbpath": "gdb-multiarch.exe"
      },
      "osx": {
        "gdbpath": "gdb"
      },
      "executable": "${workspaceRoot}/psxeg.elf",
      "autorun": [
        "monitor reset hard shellhalt",
        "monitor mountcd ${workspaceRoot}/makeISO/pseg.cue",
        "load psxeg.elf",
        "tbreak main",
        "continue"
      ]
    },
    {
      "type": "gdb",
      "request": "attach",
      "name": "NOPS GDB Attach",
      "target": "localhost:3333",
      "remote":true,
      "valuesFormatting": "parseText",
      "gdbpath": "/usr/bin/gdb",
      "cwd": "${workspaceRoot}",
      "executable": "${workspaceRoot}/psxeg.elf",
      "preLaunchTask": "Build Debug",
      "autorun": [
        "symbol-file ./psxeg.elf",
        "set substitute-path /project .",
        "load ./psxeg.elf",
        "tbreak main",
        //"continue"
      ],
      
    }
  ]
}